# ========================================================
# PERFECT CORP YOUCAM / UCAM CLOUD API CONFIGURATION
# ========================================================
# Required for live Perfect Corp Cloud AI/AR virtual try-on processing.
# When omitted, the app seamlessly runs on its built-in client-side AR visual engine.

# 1. Provide your YouCam App ID or Client ID:
YOUCAM_APP_ID=
YOUCAM_CLIENT_ID=

# 2. (Optional) Provide your API Secret Key or Access Token:
# Some YouCam enterprise setups authenticate via App ID alone, while others require an API Key.
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=

# 3. (Optional) YouCam API Endpoint (defaults to Perfect Corp Cloud Makeup apply endpoint)
YOUCAM_API_URL=https://yce-api.perfectcorp.com/v1/makeup/apply

# Backward compatibility aliases
UCAM_APP_ID=
UCAM_API_KEY=
UCAM_API_URL=
PERFECTCORP_API_KEY=
